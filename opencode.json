{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": false,
        "headerTimeout": 1800000,
        "chunkTimeout": 900000,
        "keep_alive": -1
      },
      "models": {
        "qwen3.6-35b-a3b-64k": {
          "name": "Qwen3.6 35B-A3B 64k (programador)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "gemma4-26b-64k": {
          "name": "Gemma 4 26B 64k (revisor)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "devstral-small-2-32k": {
          "name": "Devstral Small 2 24B 32k (alternativa)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-64k": {
          "name": "Qwen3.5 9B 64k (rápido)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "ministral-3-14b-32k": {
          "name": "Ministral 3 14B 32k (revisor)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "question": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "*sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git filter-repo*": "deny",
      "git filter-branch*": "deny",
      "git branch -D*": "deny",
      "gh repo *": "deny",
      "gh pr create*": "deny",
      "gh release *": "deny",
      "curl *|*": "deny",
      "wget *|*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "shred *": "deny",
      "chmod -R 777*": "deny",
      "*.env": "deny",
      "*.env *": "deny",
      "*.ssh*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.env.example": "allow",
      "rm -rf $HOME*": "deny",
      "rm -rf .": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*/.ssh/*": "deny",
      "*/.aws/*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/.ssh/*": "deny",
      "*.env.example": "allow"
    },
    "doom_loop": "deny"
  }
}
